; ================================================================
; MCD Y MCM POR EUCLIDES (con subrutina)
;
; Cobertura: VAS/CRU/FRU, paso de parámetros, ALT+FIN
; ================================================================

LEAL
TITULO EUCLIDES
ENT X Y R P L A B C
FLO
REF (3)

; ================================================================
; FASE 1: Leer los dos enteros
; ================================================================
TIT A:
LEC X
TIT B:
LEC Y

; Normalizar signos: MCD y MCM se definen no negativos
X EAB = X
Y EAB = Y

; ================================================================
; FASE 2: Llamar a la subrutina GCD(X, Y) -> R
; ================================================================
VAS (1) X, Y, R

; ================================================================
; FASE 3: Mostrar MCD
; ================================================================
TIT GCD:
ESP 1
PER R
LIN

; ================================================================
; FASE 4: Calcular MCM = (X / R) : Y
; (dividir antes evita desbordar X:Y)
; ================================================================
X / R = P
P : Y = L

TIT LCM:
ESP 1
PER L
LIN

ALT

; ================================================================
; SUBRUTINA: GCD(A, B) -> A   (Euclides por división)
;
; Algoritmo:  while B != 0:  (A, B) = (B, A mod B)
; ================================================================
(1) CRU A B
(2) B ? SSC (3)
    A / B = C
    C : B = C
    A - C = C
    B = A
    C = B
    VEA (2)
(3) FRU (1) A

FIN