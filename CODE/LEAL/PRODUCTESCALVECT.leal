	LEAL
	PRODUCTO ESCALAR DE DOS VECTORES
	ENT I
	FLO A(3) B(3) R
	REF (2)
; --- Lectura de los componentes del vector A ---
	0 = I
(1)	CIC
		LEC A(I)						; Lee A(0), A(1), A(2)
	REP (1) I, 1, 3
; --- Lectura de los componentes del vector B ---
	0 = I
(2)	CIC
		LEC B(I)						; Lee B(0), B(1), B(2)
	REP (2) I, 1, 3
; --- Cálculo del producto escalar reutilizando variables ---
; R = A(0):B(0)
; R = R + A(1):B(1)
; R = R + A(2):B(2)
	A(1) : B(1) = R						; NOTA: los índices reales son (0), (1), (2).
	A(2) : B(2) + R = R
	A(3) : B(3) + R = R
	PER R								; Imprime el resultado
	FIN