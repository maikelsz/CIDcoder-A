; ================================================================
; CALCULADORA CON MENÚ (valida CIC tipo 0)
;
; Cobertura: CIC tipo 0, REP sin args, acumulador, dispatch
; ================================================================

	LEAL
	TITULO CALC
	ENT T O X
	FLO
	REF (5)

	0 = T

; ================================================================
; BUCLE PRINCIPAL (CIC tipo 0)
; ================================================================
(1)	CIC
		TIT 1=ADD 2=SUB 3=SHOW 4=EXIT
		LIN
		LEC O

; Despacho por opción
		O - 4 ? SSC (5)	; 4 → salir
		O - 3 ? SSC (4)	; 3 → mostrar
		O - 1 ? SSC (2)	; 1 → sumar
		O - 2 ? SSC (3)	; 2 → restar

; Opción inválida (cae a REP → loop)
		TIT INVALID
		LIN
	REP (1)				; REP sin args = bucle infinito

; ================================================================
; ACCIONES (fuera del bloque CIC, entran por SSC, salen con VEA(1))
; ================================================================

(2)						; --- ACCIÓN: SUMAR ---
	TIT X:
	LEC X
	T + X = T
	VEA (1)

(3)						; --- ACCIÓN: RESTAR ---
	TIT X:
	LEC X
	T - X = T
	VEA (1)

(4)						; --- ACCIÓN: MOSTRAR ---
	TIT TOTAL:
	ESP 1
	PER T
	LIN
	VEA (1)

(5)						; --- SALIDA ---
	TIT BYE
	LIN

	FIN