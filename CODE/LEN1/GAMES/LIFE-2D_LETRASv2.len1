*0600
GEN_A_SLOT,   0000
              LAC
              SUM C1 
              YLO K_20
              SUM C4 
              YLO K_20
              SUM C5 
              YLO K_20
              LEN
              RD4
              DEL TMP
              LAC
              DEL X_IDX
              VAS I P_HANDLE

              LAC
              SUM C0 
              YLO K_20
              SUM C2 
              YLO K_20
              SUM C4 
              YLO K_20
              SUM C5 
              YLO K_20
              SUM C6 
              YLO K_20
              LEN
              RD4
              DEL TMP
              LAC
              SUM K_1
              DEL X_IDX
              VAS I P_HANDLE

              LAC
              SUM C1 
              YLO K_20
              SUM C3 
              YLO K_20
              SUM C5 
              YLO K_20
              SUM C6 
              YLO K_20
              SUM C7 
              YLO K_20
              LEN
              RD4
              DEL TMP
              LAC
              SUM K_2
              DEL X_IDX
              VAS I P_HANDLE
              VEA I GEN_A_SLOT

