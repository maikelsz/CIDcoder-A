/ ═════════════════════════════════════════════════════════════
/ PÁGINA 1: MAIN, LOOP, GEN_SLOT, HANDLE, HALT
/ ═════════════════════════════════════════════════════════════
*0200
MAIN,         LAC
              SUM K_GEN
              DEL C0
              SUM K_GEN+1
              DEL C1
              SUM K_GEN+2
              DEL C2
              SUM K_GEN+3
              DEL C3
              SUM K_GEN+4
              DEL C4
              SUM K_GEN+5
              DEL C5
              SUM K_GEN+6
              DEL C6
              SUM K_GEN+7
              DEL C7
              SUM K_GEN+8
              DEL C8
              SUM K_GEN+9
              DEL C9
              SUM K_GEN+10
              DEL C10
              SUM K_GEN+11
              DEL C11
              SUM K_GEN+12
              DEL C12
              SUM K_GEN+13
              DEL C13
              SUM K_GEN+14
              DEL C14
              SUM K_GEN+15
              DEL C15
              LAC
              SUM K_NEGGEN
              DEL GENCNT

LOOP,         LAC
              SUM K_TICK
              DEL TICK
DLP,          VAS I P_DISPLAY
              ISC TICK
              VEA DLP
              VAS GEN_SLOT
              ISC GENCNT
              VEA LOOP

HALT,         ALT
              VEA HALT

GEN_SLOT,     0000
              VAS I P_GEN_A
              VAS I P_GEN_B
              VAS I P_GEN_C
              VAS I P_GEN_D
              VAS I P_GEN_E
              VAS I P_GEN_F
              SUM N0
              DEL C0
              SUM N1
              DEL C1
              SUM N2
              DEL C2
              SUM N3
              DEL C3
              SUM N4
              DEL C4
              SUM N5
              DEL C5
              SUM N6
              DEL C6
              SUM N7
              DEL C7
              SUM N8
              DEL C8
              SUM N9
              DEL C9
              SUM N10
              DEL C10
              SUM N11
              DEL C11
              SUM N12
              DEL C12
              SUM N13
              DEL C13
              SUM N14
              DEL C14
              SUM N15
              DEL C15
              VEA I GEN_SLOT

/ ═════ HANDLE compartido ═════
/ Entrada: TMP=count, X_IDX=índice. Escribe N[X_IDX].
HANDLE,       0000
              LAC
              SUM TMP
              CAC IAC
              SUM K_3
              SAC
              VEA H_N3
              VEA H_V
H_N3,         CAC IAC
              IAC
              SAC
              VEA H_M
              LAC
              SUM K_CBASE
              SUM X_IDX
              DEL PTR2
              SUM I PTR2
              DEL TMP2
              LAC
              SUM K_NBASE
              SUM X_IDX
              DEL PTR2
              LAC
              SUM TMP2
              DEL I PTR2
              VEA I HANDLE
H_V,          LAC
              SUM K_ABASE
              SUM X_IDX
              DEL PTR2
              SUM I PTR2
              DEL TMP2
              LAC
              SUM K_NBASE
              SUM X_IDX
              DEL PTR2
              LAC
              SUM TMP2
              DEL I PTR2
              VEA I HANDLE
H_M,          LAC
              SUM K_NBASE
              SUM X_IDX
              DEL PTR2
              DEL I PTR2
              VEA I HANDLE

/ ═════════════════════════════════════════════════════════════
/ PÁGINA 2: DISPLAY multiplexado (5 palabras por celda viva,
/ 4 por muerta; TAT no necesita LAC porque SUM ya deja
/ el valor en AC)
/ ═════════════════════════════════════════════════════════════
*0400
DISP_SLOT,    0000
              LAC
              SUM C0
              SAD
              VEA d0
              TAT
d0,           SUM C1
              SAD
              VEA d1
              TAT
d1,           SUM C2
              SAD
              VEA d2
              TAT
d2,           SUM C3
              SAD
              VEA d3
              TAT
d3,           SUM C4
              SAD
              VEA d4
              TAT
d4,           SUM C5
              SAD
              VEA d5
              TAT
d5,           SUM C6
              SAD
              VEA d6
              TAT
d6,           SUM C7
              SAD
              VEA d7
              TAT
d7,           SUM C8
              SAD
              VEA d8
              TAT
d8,           SUM C9
              SAD
              VEA d9
              TAT
d9,           SUM C10
              SAD
              VEA d10
              TAT
d10,          SUM C11
              SAD
              VEA d11
              TAT
d11,          SUM C12
              SAD
              VEA d12
              TAT
d12,          SUM C13
              SAD
              VEA d13
              TAT
d13,          SUM C14
              SAD
              VEA d14
              TAT
d14,          SUM C15
              SAD
              VEA d15
              TAT
d15,          VEA I DISP_SLOT

